{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firestore.rules", "README.md", "package.json", "node_modules/**", ".git/**"],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
